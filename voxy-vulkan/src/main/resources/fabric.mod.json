{
  "schemaVersion": 1,
  "id": "voxy-vulkan",
  "version": "${version}",
  "name": "Voxy Vulkan",
  "description": "Runs Voxy's own LOD renderer on Minecraft's Vulkan renderer: Voxy draws through a hidden OpenGL context into images shared with Vulkan. Voxy itself is used unchanged, as installed by the player.",
  "authors": [
    "laurensanp"
  ],
  "contact": {
    "sources": "https://github.com/laurensanp/siris",
    "issues": "https://github.com/laurensanp/siris/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.siris.voxyvulkan.VoxyVulkan"
    ]
  },
  "mixins": [
    "voxy-vulkan.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.3",
    "voxy": "0.2.20-beta",
    "sodium": "*"
  }
}
